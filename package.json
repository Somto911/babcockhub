{
  "name": "babcockhub",
  "version": "1.0.0",
  "description": "Campus social network prototype with live chat",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "prod": "npm run build && npm start",
    "cap:sync": "npm run build && npx cap copy android",
    "cap:open": "npx cap open android"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.22.1",
    "socket.io": "^4.8.3",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "nodemon": "^2.0.22"
  }
}
